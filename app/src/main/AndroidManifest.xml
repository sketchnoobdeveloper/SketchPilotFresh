<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="pro.sketchware" />
    </queries>

    <application
        android:name="snd.sketchpilot.app.SketchPilotApp"
        android:allowBackup="false"
        android:label="SketchPilot"
        android:supportsRtl="true"
        android:theme="@style/SketchPilotTheme">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="SketchPilot - agentic IDE for Sketchware Pro" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:value="pro.sketchware" />

        <activity
            android:name="snd.sketchpilot.app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name="snd.sketchpilot.app.McpService" android:exported="false" />
    </application>
</manifest>
